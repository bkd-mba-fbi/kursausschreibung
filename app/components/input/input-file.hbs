{{#if this.isUploadControlVisible}}
<div class="js-upload uk-form-custom">
    <input id="file{{@field.id}}" class="uk-input" type="file" accept={{@field.acceptFileType}} name={{@field.id}} required={{@field.options.required}} disabled={{@field.options.disabled}} {{on "change" this.handleChange}}>
    {{#if @field.options.required}}
    <button id="fileBt{{@field.id}}" class="uk-button uk-button-default required" type="button" tabindex="-1" required={{@field.options.required}}>{{@field.fileTypeLabel}}</button>
    {{else}}
    <button id="fileBt{{@field.id}}" class="uk-button uk-button-default" type="button" tabindex="-1" required={{@field.options.required}}>{{@field.fileTypeLabel}}</button>
    {{/if}}
</div>
{{/if}}
<div id="imgModal{{@field.id}}" class="crop-modal {{if this.isCropModalOpen '' 'uk-hidden'}}" role="dialog" aria-modal="true">
    <button type="button" class="crop-modal__backdrop" {{on "click" this.cancelCrop}} aria-label={{translate key="cropModalCancel"}}></button>
    <div class="crop-modal__panel" role="document">
        <div class="crop-modal__header">{{translate key="cropModalTitle"}}</div>
        <p class="crop-modal__hint">{{translate key="cropModalHint"}}</p>

        <div id="img{{@field.id}}" class="crop-modal__canvas {{if this.isCropCanvasVisible '' 'uk-hidden'}}">
            <img id="imgCrop{{@field.id}}" class="crop-modal__image" width="300" height="400" alt={{translate key="cropModalPreviewAlt"}}>
        </div>

        <div class="crop-modal__actions">
            <button type="button" class="uk-button uk-button-default" {{on "click" this.cancelCrop}}>{{translate key="cropModalCancel"}}</button>
            <button type="button" id="fileBtUpload{{@field.id}}" class="uk-button uk-button-primary {{if this.isUploadConfirmVisible '' 'uk-hidden'}}" {{on "click" this.uploadImage}}>{{translate key="cropModalConfirm"}}</button>
        </div>
    </div>
</div>
<img id="imgDev{{@field.id}}" class="uk-margin uk-hidden" width="100" alt={{translate key="cropUploadedPreviewAlt"}} />
<button type="button" id="fileBtDel{{@field.id}}" class="uk-button-danger uk-hidden" {{on "click" this.deleteFile}}><span uk-icon="icon: close; ratio: 1"></span></button>
