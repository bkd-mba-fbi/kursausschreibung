{{#if this.showBreadcrumbs}}
  <ul class="uk-breadcrumb">
    <li>
      <LinkTo @route="list">{{this.model.AreaOfEducation}}</LinkTo>
    </li>
    <li>
      <LinkTo @route="list.category">{{this.model.EventCategory}}</LinkTo>
    </li>
  </ul>
{{/if}}

<h2>
  <span class="uk-flex">
    <span><StatusLamp @status={{this.model.status}} /></span>
    <span>{{this.model.displayData.Designation}}</span>
  </span>
</h2>
{{#if this.model.subtitle}}
<span class="uk-label uk-label-warning uk-margin-small">{{this.model.subtitle}}</span>
{{/if}}
<EventDetailsTable @event={{this.model}} />

{{#if this.badgeFreeSeatsEnabled}}
    <RemainingSeatsBadge @event={{this.model}} />
{{/if}}

<div class="uk-margin">

{{#if this.isTypeTwoSubscription}}
  {{#if this.model.subscriptionWithLoginURL}}
    <a id="subscriptionWithLoginURL" href={{this.model.subscriptionWithLoginURL}} target="_blank" rel="noopener" class="uk-button uk-button-primary uk-float-left subscribeWithLogin-button"
      data-uk-tooltip={{translate key=(concat this.model.status "Lamp")}} >{{translate key="subscribeWithLogin"}}</a>
  {{else}}
    <button id="subscribeButton" data-uk-tooltip={{translate key=(concat this.model.status "Lamp")}} disabled class="uk-button uk-button-primary uk-float-left subscribe-button">{{translate key="subscribe"}}</button>
  {{/if}}
{{else if this.model.externalSubscriptionURL}}
  <a id="externalSubscriptionURL" href={{this.model.externalSubscriptionURL}} class="uk-button uk-button-primary uk-float-left subscribe-button"
    target="_blank" rel="noopener">
    {{translate key="subscribe"}}
  </a>
{{else if this.model.canDoSubscription}}
    <LinkTo id="subscribeButton" @route="list.category.event.subscribe" data-uk-tooltip={{translate key=(concat this.model.status "Lamp")}} class="uk-button uk-button-primary uk-float-left subscribe-button">{{translate key="subscribe"}}</LinkTo>
    {{#if this.model.subscriptionWithLoginURL}}
      <div class="uk-margin">
        <a id="subscriptionWithLoginURL" href={{this.model.subscriptionWithLoginURL}}  target="_blank" rel="noopener" class="uk-button uk-button-primary uk-float-left subscribeWithLogin-button"
          data-uk-tooltip={{translate key=(concat this.model.status "Lamp")}} >{{translate key="subscribeWithLogin"}}</a>
      </div>
    {{/if}}
{{else}}
    <button id="subscribeButton" data-uk-tooltip={{translate key=(concat this.model.status "Lamp")}} disabled class="uk-button uk-button-primary uk-float-left subscribe-button">{{translate key="subscribe"}}</button>
{{/if}}
</div>
<div class="uk-margin">
  <LinkTo @route="list.category" class="uk-button uk-button-default uk-float-right">{{translate key="back"}}</LinkTo>
</div>
