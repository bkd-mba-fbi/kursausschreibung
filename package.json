{
  "name": "kursausschreibung",
  "version": "3.3.4",
  "private": true,
  "description": "Evento JS Module for online course announcement",
  "license": "MIT",
  "author": "bkd-mba-fbi",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bkd-mba-fbi/kursausschreibung.git"
  },
  "scripts": {
    "npmInstall": "npm install",
    "build": "vite build",
    "lint": "concurrently \"npm:lint:js\" \"npm:lint:css\" --names \"js,css\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs:fix": "npx ember-template-lint . --fix",
    "lint:js": "npx eslint . --cache",
    "lint:js:fix": "npx eslint . --fix",
    "start": "vite",
    "test:ember": "vite build --mode development && ember test --path dist",
    "test": "concurrently \"npm:lint\" \"npm:test:ember\" --names \"lint,test\""
  },
  "ember": {
    "edition": "octane"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.21.3",
    "@babel/plugin-proposal-decorators": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@ember/optional-features": "^2.1.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.17",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/vite": "^1.7.2",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "concurrently": "^8.0.1",
    "cropperjs": "^2.1.1",
    "date-fns": "^2.15.0",
    "decorator-transforms": "^2.3.1",
    "ember-cli": "^6.12.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-htmlbars": "^6.2.0",
    "ember-cli-update": "^3.0.1",
    "ember-compatibility-helpers": "^1.2.7",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.1.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "eslint": "^8.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^11.5.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-qunit": "^7.3.4",
    "prettier": "^3.9.10",
    "qunit": "^2.19.4",
    "qunit-dom": "^3.6.0",
    "stylelint": "^15.4.0",
    "stylelint-config-standard": "^32.0.0",
    "stylelint-prettier": "^4.1.0",
    "tracked-built-ins": "^3.1.1",
    "uikit": "^3.25.28",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">= 20"
  },
  "overrides": {
    "testem": "3.18.0",
    "rollup": "^4.22.4"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
